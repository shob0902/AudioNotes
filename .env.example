# =============================================================================
# Audio Notes Platform — Environment Variables
# Copy this file to .env for local development and fill in real values.
# NEVER commit the real .env file. Secrets in Render are set via its dashboard.
# =============================================================================

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# Local docker-compose default. On Render, use the Internal Database URL
# from your Render PostgreSQL instance.
DATABASE_URL=postgresql+psycopg://audio_notes:audio_notes@localhost:5432/audio_notes

# ---------------------------------------------------------------------------
# Auth (JWT bearer tokens — simple email/password, no OAuth)
# ---------------------------------------------------------------------------
# Required, no default. Generate with: openssl rand -hex 32
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
# 10080 minutes = 7 days
JWT_EXPIRES_MINUTES=10080

# ---------------------------------------------------------------------------
# Gnani Speech-to-Text API
# https://docs.gnani.ai/api/STT/speech-to-text
# ---------------------------------------------------------------------------
GNANI_API_KEY=
GNANI_API_URL=https://api.vachana.ai/stt/v3
# BCP-47 language code Gnani expects, e.g. en-IN, hi-IN, ta-IN
GNANI_LANGUAGE_CODE=en-IN
# "verbatim" (raw) or "transcribe" (inverse-text-normalized)
GNANI_TRANSCRIPT_FORMAT=transcribe
# Gnani caps a single request at 60s of audio (ideal <=30s). Chunk length in
# seconds used when splitting longer uploads. Must stay <= 60.
GNANI_CHUNK_SECONDS=30
# HTTP timeout (seconds) per Gnani request
GNANI_TIMEOUT_SECONDS=45
# Max retry attempts for transient Gnani errors (429/500/503/timeouts)
GNANI_MAX_RETRIES=3

# ---------------------------------------------------------------------------
# Groq LLM API
# ---------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
# Any currently available Groq chat model. openai/gpt-oss-120b is a good
# general-purpose choice for structured summarization.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=60
GROQ_MAX_RETRIES=3
# Approximate max characters of transcript sent per Groq call before the
# transcript is chunked and map-reduce summarized instead.
GROQ_MAX_INPUT_CHARS=12000

# ---------------------------------------------------------------------------
# Object Storage (S3-compatible: Cloudflare R2, Supabase Storage, MinIO, AWS S3)
# For local dev without a real bucket, `docker compose up -d minio
# createbuckets` gives you a local S3-compatible store — use:
#   STORAGE_ENDPOINT=http://localhost:9000
#   STORAGE_ACCESS_KEY=minioadmin / STORAGE_SECRET_KEY=minioadmin
#   STORAGE_REGION=us-east-1
# ---------------------------------------------------------------------------
STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
STORAGE_BUCKET=audio-notes
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=auto
# Set to "true" if your bucket/provider requires path-style URLs (MinIO, R2)
STORAGE_USE_PATH_STYLE=true
# Optional: public base URL for serving files directly (e.g. R2 public bucket
# domain or a CDN in front of the bucket). If unset, the backend generates
# short-lived pre-signed URLs on demand instead.
STORAGE_PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# Upload limits & validation
# ---------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=200
MIN_AUDIO_DURATION_SECONDS=120

# ---------------------------------------------------------------------------
# Audio decoding (ffmpeg) — optional. Leave blank to use whatever `ffmpeg`/
# `ffprobe` resolve to on PATH (fine in Docker/Render). Set these to pin
# exact binaries on a dev machine, e.g. after `winget install Gyan.FFmpeg`
# (Windows) or `brew install ffmpeg` (Mac, usually already on PATH so this
# can stay blank there).
# ---------------------------------------------------------------------------
FFMPEG_PATH=
FFPROBE_PATH=

# ---------------------------------------------------------------------------
# App URLs / CORS
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Frontend-only variables (Vite requires the VITE_ prefix to expose them to
# the browser bundle — nothing else in this file is ever sent to the client)
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api
VITE_GITHUB_REPO_URL=https://github.com/<your-username>/audio-notes
